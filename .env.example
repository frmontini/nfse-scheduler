# Aplicação
PORT=3000
DATA_DIR=/data
TZ=America/Sao_Paulo
# Intervalo entre ciclos do worker, em minutos (dentro da janela do painel).
# Cada ciclo processa no máximo UMA nota; 240 = de 4 em 4 horas.
WORKER_INTERVAL_MINUTES=240
NODE_ENV=production
APP_ADMIN_USER=admin
# Obrigatório quando NODE_ENV=production: sem senha o painel se recusa a subir.
# Só ignore isso com ALLOW_NO_AUTH=1, se houver outra proteção na frente.
APP_ADMIN_PASSWORD=

# Emissor Nacional - use o login próprio de CPF/CNPJ + senha do portal.
# NÃO use senha do gov.br aqui.
NFSE_LOGIN=
NFSE_PASSWORD=
NFSE_BASE_URL=https://www.nfse.gov.br
PLAYWRIGHT_HEADLESS=true
BROWSER_SLOW_MO_MS=0

# ---------------------------------------------------------------------------
# E-mail: escolha o provedor -> smtp | brevo
# Na DigitalOcean as portas SMTP (25/465/587) vêm bloqueadas por padrão,
# então use brevo, que sai pela API HTTPS (443) e não esbarra no bloqueio.
# ---------------------------------------------------------------------------
MAIL_PROVIDER=brevo
MAIL_FROM="NFS-e <financeiro@exemplo.com>"

# Brevo (MAIL_PROVIDER=brevo): chave em https://app.brevo.com -> SMTP & API -> API Keys
BREVO_API_KEY=

# SMTP (MAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
